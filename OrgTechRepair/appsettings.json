{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=orgtechrepairdb;Username=postgres;Password=postgres",
    "SqliteFallback": "Data Source=orgtechrepair.db"
  },
  "Database": {
    "PgDumpPath": "C:\\Program Files\\PostgreSQL\\18\\bin\\pg_dump.exe",
    "AllowSqliteFallback": false,
    "MaxPoolSize": 120,
    "CommandTimeoutSeconds": 12
  },
  "Security": {
    "Captcha": {
      "Enabled": true,
      "UseExternal": true,
      "AllowLocalFallback": true,
      "Provider": "turnstile",
      "SiteKey": "PASTE_TURNSTILE_SITE_KEY",
      "SecretKey": "PASTE_TURNSTILE_SECRET_KEY",
      "VerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
    },
    "TwoFactor": {
      "Enabled": true,
      "EnableAuthenticatorFallback": true
    }
  },
  "OrdersArchive": {
    "FolderPath": "%USERPROFILE%\\Desktop\\Заявки на ремонт"
  },
  "DataProtection": {
    "KeysPath": "",
    "CertificatePath": "",
    "CertificatePassword": ""
  },
  "Jwt": {
    "Key": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "OrgTechRepair",
    "Audience": "OrgTechRepair"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
