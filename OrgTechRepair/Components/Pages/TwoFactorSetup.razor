@page "/TwoFactorSetup"
@using System.Net
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@attribute [Authorize]
@inject UserManager<IdentityUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Configuration

<PageTitle>Двухфакторная аутентификация</PageTitle>

<div class="container mt-4 mb-4">
    <h2 class="mb-3">Двухфакторная аутентификация (2FA)</h2>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-success">@statusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="text-muted mb-3">@((isEnabled ? "2FA включена" : "2FA отключена"))</p>

        <div class="card">
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(qrImageUrl))
                {
                    <img class="twofa-qr" src="@qrImageUrl" alt="QR для 2FA" />
                }

                <form method="post" @onsubmit="EnableTwoFactorAsync">
                    <div class="mb-3">
                        <label class="form-label" for="code">Код из приложения</label>
                        <input id="code" class="form-control" @bind="code" maxlength="6" />
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Подтвердить и включить 2FA</button>
                </form>
            </div>
        </div>

        @if (recoveryCodes.Count > 0)
        {
            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="mb-2">Резервные коды (сохраните отдельно)</h5>
                    @foreach (var rc in recoveryCodes)
                    {
                        <div class="twofa-code-item">@rc</div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private string? errorMessage;
    private string? statusMessage;
    private bool isEnabled;
    private string code = string.Empty;
    private string? qrImageUrl;
    private List<string> recoveryCodes = new();
    private IdentityUser? currentUser;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(userId))
        {
            errorMessage = "Пользователь не авторизован.";
            return;
        }

        currentUser = await UserManager.FindByIdAsync(userId);
        if (currentUser == null)
        {
            errorMessage = "Пользователь не найден.";
            return;
        }

        isEnabled = await UserManager.GetTwoFactorEnabledAsync(currentUser);
        var key = await UserManager.GetAuthenticatorKeyAsync(currentUser);
        if (string.IsNullOrWhiteSpace(key))
        {
            await UserManager.ResetAuthenticatorKeyAsync(currentUser);
            key = await UserManager.GetAuthenticatorKeyAsync(currentUser);
        }

        if (string.IsNullOrWhiteSpace(key))
        {
            errorMessage = "Не удалось сгенерировать ключ аутентификатора.";
            return;
        }

        var issuer = Uri.EscapeDataString(Configuration["Jwt:Issuer"] ?? "OrgTechRepair");
        var label = Uri.EscapeDataString(currentUser.Email ?? currentUser.UserName ?? "user");
        var otpauth = $"otpauth://totp/{issuer}:{label}?secret={key}&issuer={issuer}&digits=6";
        qrImageUrl = "https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=" + WebUtility.UrlEncode(otpauth);
    }

    private async Task EnableTwoFactorAsync()
    {
        if (currentUser == null)
        {
            errorMessage = "Сессия устарела. Обновите страницу.";
            return;
        }

        var normalized = (code ?? string.Empty).Replace(" ", string.Empty).Replace("-", string.Empty);
        var ok = await UserManager.VerifyTwoFactorTokenAsync(
            currentUser,
            UserManager.Options.Tokens.AuthenticatorTokenProvider,
            normalized);

        if (!ok)
        {
            statusMessage = null;
            errorMessage = "Неверный код из приложения.";
            return;
        }

        await UserManager.SetTwoFactorEnabledAsync(currentUser, true);
        recoveryCodes = (await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(currentUser, 10))?.ToList() ?? new List<string>();
        isEnabled = true;
        errorMessage = null;
        statusMessage = "Сканируйте QR и подтвердите кодом из приложения.";
    }
}

<style>
    .twofa-qr {
        width: 220px;
        height: 220px;
        display: block;
        margin-bottom: 1rem;
    }
    .twofa-code-item {
        font-family: Consolas, monospace;
        font-size: .95rem;
    }
</style>
