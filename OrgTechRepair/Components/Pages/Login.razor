@page "/Login"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.Extensions.Caching.Memory
@using OrgTechRepair.Services
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery
@inject IMemoryCache MemoryCache
@inject IConfiguration Configuration

<PageTitle>Вход в систему</PageTitle>

<div class="container mt-5 login-page">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header text-center">
                    <h3 class="mb-0">Вход</h3>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mb-3">@errorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(infoMessage))
                    {
                        <div class="alert @(twoFactorEmailSent ? "alert-info" : "alert-warning") mb-3">@infoMessage</div>
                    }

                @if (isTwoFactorStep)
                {
                    @if (captchaEnabled)
                    {
                        <div class="alert alert-secondary mb-3" role="status">
                            @if (twoFactorEmailSent)
                            {
                                <text>Проверка «не робот» выполнена. Введите код из письма на ваш email.</text>
                            }
                            else if (isRenderHost)
                            {
                                <text>Проверка «не робот» выполнена. Письмо не доставлено — см. жёлтое сообщение выше и логи Render.</text>
                            }
                            else
                            {
                                <text>Проверка «не робот» выполнена. Письмо не доставлено — возьмите код из файла OrgTechRepair-2FA-last.txt (см. сообщение выше).</text>
                            }
                        </div>
                    }
                    <form method="post" action="/Account/VerifyTwoFactorWeb">
                        <input type="hidden" name="__RequestVerificationToken" value="@GetAntiforgeryToken()" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <input type="hidden" name="challengeId" value="@challengeId" />

                        <div class="mb-3">
                            <label class="form-label">Код подтверждения</label>
                            <input type="text" name="code" class="form-control" maxlength="6" required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Подтвердить вход</button>
                    </form>
                    <form method="post" action="/Account/ResendTwoFactorWeb" class="mt-2">
                        <input type="hidden" name="__RequestVerificationToken" value="@GetAntiforgeryToken()" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <input type="hidden" name="challengeId" value="@challengeId" />
                        <button id="resendCodeButton" type="submit" class="btn btn-outline-secondary w-100">Отправить код повторно</button>
                    </form>
                    <div id="resendCodeHint" class="form-text text-center mt-2"></div>
                }
                else
                {
                    <form method="post" action="/Account/Login">
                        <input type="hidden" name="__RequestVerificationToken" value="@GetAntiforgeryToken()" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <input type="hidden" name="captchaId" value="@captchaId" />

                        <div class="mb-3">
                            <label class="form-label">Логин или почта</label>
                            <input id="loginOrEmail" type="text" name="loginOrEmail" class="form-control" autocomplete="username" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Пароль</label>
                            <input type="password" name="password" class="form-control" autocomplete="current-password" required />
                        </div>

                        <div class="mb-3">
                            <input type="checkbox" name="rememberMe" value="true" class="form-check-input" id="rememberMe" />
                            <label class="form-check-label" for="rememberMe">Запомнить меня</label>
                        </div>

                        @if (captchaEnabled && useExternalCaptcha && !string.IsNullOrWhiteSpace(captchaSiteKey))
                        {
                            <div class="captcha-box">
                                <div id="turnstile-widget"
                                     class="cf-turnstile"
                                     data-sitekey="@captchaSiteKey"
                                     data-response-field="true"
                                     data-response-field-name="cf-turnstile-response"
                                     data-appearance="always"
                                     data-callback="onTurnstileSuccess"
                                     data-expired-callback="onTurnstileExpired"
                                     data-error-callback="onTurnstileError"></div>
                            </div>
                        }
                        else if (captchaEnabled && !string.IsNullOrWhiteSpace(captchaQuestion))
                        {
                            <div class="mb-3">
                                <label class="form-label">Капча: @captchaQuestion</label>
                                <input type="text" name="captchaAnswer" class="form-control" autocomplete="off" required />
                            </div>
                        }

                        <button type="submit" class="btn btn-primary w-100">Войти</button>
                    </form>
                }

                <div class="text-center mt-3">
                    <a href="/ForgotPassword" class="btn btn-link p-0">Забыли пароль?</a>
                </div>

                <div class="text-center mt-2">
                    <p>Нет аккаунта? <a href="/Register">Зарегистрироваться</a></p>
                </div>
                </div>
            </div>
            </div>
        </div>
    </div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
    window.focusLoginInput = function () {
        var input = document.getElementById("loginOrEmail");
        if (input) {
            input.focus();
        }
    };

    window.onTurnstileSuccess = function (_token) {
        // Token is posted via cf-turnstile-response hidden input.
    };

    window.onTurnstileExpired = function () {
        if (window.turnstile) {
            window.turnstile.reset();
        }
        window.focusLoginInput();
    };

    window.onTurnstileError = function () {
        if (window.turnstile) {
            window.turnstile.reset();
        }
        window.focusLoginInput();
    };

    window.addEventListener("load", function () {
        var hasLoginError = new URLSearchParams(window.location.search).has("error");
        if (hasLoginError && window.turnstile) {
            window.turnstile.reset();
        }
        if (hasLoginError) {
            window.focusLoginInput();
        }
    });
</script>
@if (isTwoFactorStep)
{
    <script>
        (function () {
            var button = document.getElementById("resendCodeButton");
            var hint = document.getElementById("resendCodeHint");
            if (!button || !hint) return;

            var secondsLeft = @twoFactorResendCooldownSeconds;
            var tick = function () {
                if (secondsLeft <= 0) {
                    button.disabled = false;
                    hint.textContent = "Можно отправить код повторно.";
                    return;
                }

                button.disabled = true;
                hint.textContent = "Повторная отправка через " + secondsLeft + " сек.";
                secondsLeft -= 1;
                setTimeout(tick, 1000);
            };

            tick();
        })();
    </script>
}
@code {
    private string? errorMessage;
    private string? infoMessage;
    private string? returnUrl;
    private bool isTwoFactorStep;
    private bool twoFactorEmailSent = true;
    private bool isRenderHost;
    private string? challengeId;
    private string? captchaId;
    private string? captchaQuestion;
    private bool captchaEnabled;
    private bool useExternalCaptcha;
    private string? captchaSiteKey;
    private int twoFactorResendCooldownSeconds = 30;

    protected override void OnInitialized()
    {
        // Получаем сообщение об ошибке и ReturnUrl из query string
        var uri = new Uri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        
        if (query.ContainsKey("error"))
        {
            errorMessage = query["error"].ToString();
        }
        if (query.ContainsKey("message"))
        {
            infoMessage = query["message"].ToString();
        }
        
        returnUrl = query.ContainsKey("returnUrl") ? query["returnUrl"].ToString() : 
                    query.ContainsKey("ReturnUrl") ? query["ReturnUrl"].ToString() : null;

        isTwoFactorStep = query.ContainsKey("twoFactor") && query["twoFactor"].ToString() == "1";
        challengeId = query.ContainsKey("challengeId") ? query["challengeId"].ToString() : null;
        isRenderHost = !string.IsNullOrEmpty(Environment.GetEnvironmentVariable("RENDER"));
        if (isTwoFactorStep)
        {
            twoFactorEmailSent = !query.ContainsKey("emailSent") || query["emailSent"].ToString() != "0";
        }

        captchaEnabled = CaptchaConfiguration.IsEnabled(Configuration);
        useExternalCaptcha = CaptchaConfiguration.UseExternalCaptcha(Configuration);
        captchaSiteKey = useExternalCaptcha ? Configuration["Security:Captcha:SiteKey"] : null;
        twoFactorResendCooldownSeconds = Math.Clamp(Configuration.GetValue<int?>("Security:TwoFactor:ResendCooldownSeconds") ?? 30, 5, 300);

        if (captchaEnabled && !useExternalCaptcha)
        {
            CaptchaConfiguration.IssueLocalChallenge(MemoryCache, out captchaId, out captchaQuestion);
        }
    }

    private string GetAntiforgeryToken()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
        {
            var tokenSet = Antiforgery.GetAndStoreTokens(httpContext);
            return tokenSet.RequestToken ?? string.Empty;
        }
        return string.Empty;
    }
}

<style>
    .captcha-box {
        margin: .5rem 0 1rem;
        display: flex;
        justify-content: flex-start;
    }
    .login-page p {
        margin-bottom: 0;
    }
</style>
