@page "/Login"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.Extensions.Caching.Memory
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery
@inject IMemoryCache MemoryCache
@inject IConfiguration Configuration

<PageTitle>Вход в систему</PageTitle>

<div class="container mt-5 login-page">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header text-center">
                    <h3 class="mb-0">Вход</h3>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mb-3">@errorMessage</div>
                    }

                @if (isTwoFactorStep)
                {
                    <form method="post" action="/Account/VerifyTwoFactorWeb">
                        <input type="hidden" name="__RequestVerificationToken" value="@GetAntiforgeryToken()" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <input type="hidden" name="challengeId" value="@challengeId" />

                        <div class="alert alert-info">Код подтверждения отправлен на ваш e-mail.</div>

                        <div class="mb-3">
                            <label class="form-label">Код подтверждения</label>
                            <input type="text" name="code" class="form-control" maxlength="6" required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Подтвердить вход</button>
                    </form>
                }
                else
                {
                    <form method="post" action="/Account/Login">
                        <input type="hidden" name="__RequestVerificationToken" value="@GetAntiforgeryToken()" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <input type="hidden" name="captchaId" value="@captchaId" />

                        <div class="mb-3">
                            <label class="form-label">Логин или почта</label>
                            <input id="loginOrEmail" type="text" name="loginOrEmail" class="form-control" autocomplete="username" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Пароль</label>
                            <input type="password" name="password" class="form-control" autocomplete="current-password" required />
                        </div>

                        <div class="mb-3">
                            <input type="checkbox" name="rememberMe" value="true" class="form-check-input" id="rememberMe" />
                            <label class="form-check-label" for="rememberMe">Запомнить меня</label>
                        </div>

                        @if (useExternalCaptcha && !string.IsNullOrWhiteSpace(captchaSiteKey))
                        {
                            <div class="captcha-box">
                                <div id="turnstile-widget"
                                     class="cf-turnstile"
                                     data-sitekey="@captchaSiteKey"
                                     data-response-field="true"
                                     data-response-field-name="cf-turnstile-response"
                                     data-appearance="always"
                                     data-callback="onTurnstileSuccess"
                                     data-expired-callback="onTurnstileExpired"
                                     data-error-callback="onTurnstileError"></div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(captchaQuestion))
                        {
                            <div class="mb-3">
                                <label class="form-label">Капча: @captchaQuestion</label>
                                <input type="text" name="captchaAnswer" class="form-control" autocomplete="off" required />
                            </div>
                        }

                        <button type="submit" class="btn btn-primary w-100">Войти</button>
                    </form>
                }

                <div class="text-center mt-3">
                    <a href="/ForgotPassword" class="btn btn-link p-0">Забыли пароль?</a>
                </div>

                <div class="text-center mt-2">
                    <p>Нет аккаунта? <a href="/Register">Зарегистрироваться</a></p>
                </div>
                </div>
            </div>
            </div>
        </div>
    </div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
    window.focusLoginInput = function () {
        var input = document.getElementById("loginOrEmail");
        if (input) {
            input.focus();
        }
    };

    window.onTurnstileSuccess = function (_token) {
        // Token is posted via cf-turnstile-response hidden input.
    };

    window.onTurnstileExpired = function () {
        if (window.turnstile) {
            window.turnstile.reset();
        }
        window.focusLoginInput();
    };

    window.onTurnstileError = function () {
        if (window.turnstile) {
            window.turnstile.reset();
        }
        window.focusLoginInput();
    };

    window.addEventListener("load", function () {
        var hasLoginError = new URLSearchParams(window.location.search).has("error");
        if (hasLoginError && window.turnstile) {
            window.turnstile.reset();
        }
        if (hasLoginError) {
            window.focusLoginInput();
        }
    });
</script>
@code {
    private string? errorMessage;
    private string? returnUrl;
    private bool isTwoFactorStep;
    private string? challengeId;
    private string? captchaId;
    private string? captchaQuestion;
    private bool useExternalCaptcha;
    private string? captchaSiteKey;

    protected override void OnInitialized()
    {
        // Получаем сообщение об ошибке и ReturnUrl из query string
        var uri = new Uri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        
        if (query.ContainsKey("error"))
        {
            errorMessage = query["error"].ToString();
        }
        
        returnUrl = query.ContainsKey("returnUrl") ? query["returnUrl"].ToString() : 
                    query.ContainsKey("ReturnUrl") ? query["ReturnUrl"].ToString() : null;

        isTwoFactorStep = query.ContainsKey("twoFactor") && query["twoFactor"].ToString() == "1";
        challengeId = query.ContainsKey("challengeId") ? query["challengeId"].ToString() : null;

        useExternalCaptcha = (Configuration["Security:Captcha:UseExternal"]?.ToLowerInvariant() == "true");
        captchaSiteKey = Configuration["Security:Captcha:SiteKey"];

        if (!isTwoFactorStep)
        {
            if (!(useExternalCaptcha && !string.IsNullOrWhiteSpace(captchaSiteKey)))
            {
                var left = Random.Shared.Next(1, 10);
                var right = Random.Shared.Next(1, 10);
                captchaId = Guid.NewGuid().ToString("N");
                captchaQuestion = $"{left} + {right} = ?";
                MemoryCache.Set($"captcha:{captchaId}", (left + right).ToString(), TimeSpan.FromMinutes(3));
            }
        }
    }

    private string GetAntiforgeryToken()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
        {
            var tokenSet = Antiforgery.GetAndStoreTokens(httpContext);
            return tokenSet.RequestToken ?? string.Empty;
        }
        return string.Empty;
    }
}

<style>
    .captcha-box {
        margin: .5rem 0 1rem;
        display: flex;
        justify-content: flex-start;
    }
    .login-page p {
        margin-bottom: 0;
    }
</style>
