@page "/orders"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using OrgTechRepair.Models
@using OrgTechRepair.Data
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Manager,OfficeManager,Engineer,ServiceEngineer,Director,Administrator")]
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject NavigationManager Navigation

<PageTitle>Заявки</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Заявки на ремонт</h2>
        <AuthorizeView Roles="Manager,OfficeManager,ServiceEngineer,Administrator">
            <button class="btn btn-primary" @onclick="CreateNew">Создать заявку</button>
        </AuthorizeView>
    </div>
    <div class="row g-2 mb-3">
        <div class="col-12 col-md-4">
            <label class="form-label mb-1">Статус</label>
            <select class="form-select" @bind="statusFilter">
                <option value="Все">Все</option>
                @foreach (var status in availableStatuses)
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label mb-1">Дата с</label>
            <InputDate TValue="DateTime?" @bind-Value="dateFrom" class="form-control" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label mb-1">Дата по</label>
            <InputDate TValue="DateTime?" @bind-Value="dateTo" class="form-control" />
        </div>
        <div class="col-12 col-md-2 d-flex align-items-end">
            <button class="btn btn-outline-secondary w-100" @onclick="ResetFilters">Сбросить</button>
        </div>
        <div class="col-12">
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-sm btn-outline-primary" @onclick="SetPresetToday">Сегодня</button>
                <button class="btn btn-sm btn-outline-primary" @onclick="SetPresetLast7Days">7 дней</button>
                <button class="btn btn-sm btn-outline-primary" @onclick="SetPresetLast30Days">30 дней</button>
            </div>
        </div>
    </div>

    @if (orders == null)
    {
        <p>Загрузка...</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Номер</th>
                        <th>Клиент</th>
                        <th>Модель техники</th>
                        <th>Дата заказа</th>
                        <th>Статус</th>
                        <th>Стоимость</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in FilteredOrders)
                    {
                        <tr>
                            <td>@order.OrderNumber</td>
                            <td>@order.Client?.FullName</td>
                            <td>@order.EquipmentModel</td>
                            <td>@order.OrderDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                <span class="badge bg-@GetStatusColor(order.Status)">@order.Status</span>
                            </td>
                            <td>@(order.Cost?.ToString("N2") ?? "-") руб.</td>
                            <td>
                                <button class="btn btn-sm btn-info" @onclick="() => ViewOrder(order.Id)">Просмотр</button>
                                <AuthorizeView Roles="Manager,OfficeManager,Engineer,ServiceEngineer,Administrator">
                                    <button class="btn btn-sm btn-warning" @onclick="() => EditOrder(order.Id)">Редактировать</button>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Order>? orders;
    private string statusFilter = "Все";
    private DateTime? dateFrom;
    private DateTime? dateTo;

    private List<string> availableStatuses =>
        orders?
            .Select(o => o.Status)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s)
            .ToList()
        ?? new();

    private IEnumerable<Order> FilteredOrders =>
        (orders ?? Enumerable.Empty<Order>())
        .Where(o => statusFilter == "Все" || string.Equals(o.Status, statusFilter, StringComparison.OrdinalIgnoreCase))
        .Where(o => !dateFrom.HasValue || o.OrderDate.Date >= dateFrom.Value.Date)
        .Where(o => !dateTo.HasValue || o.OrderDate.Date <= dateTo.Value.Date);

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        using var context = await DbContextFactory.CreateDbContextAsync();
        orders = await context.Orders
            .Include(o => o.Client)
            .Include(o => o.Employee)
            .OrderByDescending(o => o.OrderDate)
            .ToListAsync();
    }

    private void ResetFilters()
    {
        statusFilter = "Все";
        dateFrom = null;
        dateTo = null;
    }

    private void SetPresetToday()
    {
        var today = DateTime.Today;
        dateFrom = today;
        dateTo = today;
    }

    private void SetPresetLast7Days()
    {
        dateTo = DateTime.Today;
        dateFrom = dateTo.Value.AddDays(-6);
    }

    private void SetPresetLast30Days()
    {
        dateTo = DateTime.Today;
        dateFrom = dateTo.Value.AddDays(-29);
    }

    private void CreateNew()
    {
        Navigation.NavigateTo("/orders/create");
    }

    private void ViewOrder(int id)
    {
        Navigation.NavigateTo($"/orders/{id}");
    }

    private void EditOrder(int id)
    {
        Navigation.NavigateTo($"/orders/edit/{id}");
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "В ожидании" => "primary",
            "В работе" => "warning",
            "Выполнен" => "success",
            "Отменен" => "danger",
            _ => "secondary"
        };
    }
}
